@page
@model IndexModel
@{
    ViewData["Title"] = "MyNUnit";
}

<head>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <title></title>
</head>
<div class="text-center">
    <h1 class="display-4">MyNUnit</h1>

    <h1>Загрузить сборки:</h1>

    <form method="post" enctype="multipart/form-data" asp-page-handler="Upload">
        <div>
            <input asp-for="Files" type="file" multiple />
        </div>

        <button type="submit" class="button_download">Загрузить</button>
    </form>

    @if (Model.Error != null)
    {
        <p>@Model.Error</p>
    }

    <form method="post" enctype="multipart/form-data" asp-page-handler="Clear">
        <button type="submit" class="button_download">Очистить загруженные файлы</button>
    </form>

    <h1>Запустить тесты:</h1>

    <form method="post" enctype="multipart/form-data" asp-page-handler="RunTests">
        <button type="submit" class="button_download">Запустить</button>
    </form>

    @if (Model.Error != null)
    {
        <p>@Model.Error</p>
    }
    @if (Model.IsTestsRun)
    {
        <h1>Результаты тестирования:</h1>
        <table>
            <thead>
            <tr>
                <th>Assembly</th>
                <th>Name</th>
                <th>Status</th>
                <th>WorkTime</th>
                <th>Error</th>
                <th>IgnoreReason</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var test in Model.CurrentTests!)
            {
                <tr>
                    <td>@test.AssemblyName</td>
                    <td>@test.TestName</td>
                    <td>@test.IsPassed</td>
                    <td>@test.WorkTime</td>
                    <td>@test.ErrorMessage</td>
                    <td>@test.IgnoreReason</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>